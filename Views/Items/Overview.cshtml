@model IEnumerable<OrderManagement.Models.Order>
@{
    @* ViewData["Title"] = "Order Overview"; *@
}
<div class="container-fluid p-2">
        <div aria-live="polite" aria-atomic="true">
            <div class="toast-container position-fixed top-0 end-0 p-3">
                <div id="orderSuccessToast" class="toast bg-success text-white" role="status" aria-atomic="true" data-initial-message="@TempData["OrderSuccess"]">
                    <div class="d-flex">
                        <div class="toast-body"></div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        </div>

    <form asp-controller="Item" asp-action="Delete" method="post">
        <div class="row justify-content-between align-items-center">
            <h2 class="col-auto fw-bold">
                Order List
            </h2>
            <div class="col-auto">
                <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2"
                        data-bs-toggle="modal" data-bs-target="#orderModal" data-mode="add">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-plus-circle" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                        <path
                        d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                    </svg>
                    <span>
                        Add Order
                    </span>
                </button>
            
                <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-trash" viewBox="0 0 16 16">
                        <path
                        d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                        <path
                        d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                    </svg>
                    <span>
                        Delete
                    </span>
                </button>
            </div>
        </div>

        @if (!Model.Any())
        {
            <p class="text-center">Không có dữ liệu</p>
        }
        else
        {
        <table class="table table-striped">
            <thead class="table-light">
                <tr>
                    <th scope="col">
                        <input class="form-check-input" type="checkbox" value="" id="select-all"
                               style="cursor: pointer;">
                    </th>
                    <th scope="col">No.</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Product</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Price</th>
                    <th scope="col">Total</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="table-info">
                        <td>
                            <input class="form-check-input item" type="checkbox" value="@item.OrderId" name="ids"
                                   style="cursor: pointer;" aria-label="Select order @item.OrderId">
                        </td>
                        <th scope="row">@item.OrderId</th>
                        <td>@item.CustomerName</td>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price.ToString("N2")</td>
                        <td>@((item.Quantity * item.Price).ToString("N2"))</td>
                        <td>
                            @{

                                var statusClass = item.Status switch
                                {
                                    "Đã giao" => "bg-success fw-bold text-white",
                                    "Hủy" or "Huỷ" => "bg-danger fw-bold text-white",
                                    _ => "bg-primary fw-bold"
                                };
                            }
                            <select class="form-select status-select @statusClass" data-order-id="@item.OrderId"
                                    disabled="@(item.Status == "Đã giao" || item.Status == "Hủy" || item.Status == "Huỷ")">
                                <option value="Mới" selected="@(item.Status == "Mới")">
                                    Mới
                                </option>
                                <option value="Đã giao" selected="@(item.Status == "Đã giao")">
                                    Đã giao
                                </option>
                                <option value="Hủy" selected="@(item.Status == "Hủy" || item.Status == "Huỷ")">
                                    Hủy
                                </option>
                            </select>

                        </td>
                        <td>
                            <button type="button" class="btn btn-link" data-mode="edit" data-bs-toggle="modal"
                                    disabled="@(item.Status == "Hủy" || item.Status == "Đã giao")" data-bs-target="#orderModal"
                                    data-id="@item.OrderId" data-customer="@item.CustomerName" data-product="@item.ProductName"
                                    data-quantity="@item.Quantity"
                                    data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                     class="bi bi-pencil-square" viewBox="0 0 16 16">
                                    <path
                                    d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                    <path fill-rule="evenodd"
                                          d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                </svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    </form>
</div>

<div class="modal fade" id="orderModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Order</h5>
            </div>
            <div class="modal-body">
                <form asp-controller="Item" asp-action="Update" id="orderForm" method="post">
                    <input type="hidden" id="editOrderId" name="id">
                    <div class="mb-3">
                        <label for="customerName" class="form-label">Customer Name</label>
                        <input type="text" class="form-control" id="customerName" name="CustomerName" required>
                    </div>
                    <div class="mb-3">
                        <label for="productName" class="form-label">Product Name</label>
                        <input type="text" class="form-control" id="productName" name="ProductName" required>
                    </div>
                    <div class="mb-3">
                        <label for="quantity" class="form-label">Quantity</label>
                        <input type="number" class="form-control" id="quantity" name="Quantity" required>
                    </div>
                    <div class="mb-3">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" class="form-control" id="price" name="Price" step="0.01" required>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toast = document.getElementById('orderSuccessToast');
        if (toast.dataset.initialMessage) showOrderToast(toast.dataset.initialMessage);
    });

    function showOrderToast(message, isError = false) {
        const toast = document.getElementById('orderSuccessToast');
        toast.classList.toggle('bg-success', !isError);
        toast.classList.toggle('bg-danger', isError);
        toast.querySelector('.toast-body').textContent = message;
        bootstrap.Toast.getOrCreateInstance(toast, { delay: 2000 }).show();
    }

    const selectAll = document.getElementById('select-all');
    const items = document.querySelectorAll('.item');

    function updateStatusColor(select) {
        select.classList.remove('bg-primary', 'bg-success', 'bg-danger');
        const color = select.selectedIndex === 1 ? 'bg-success'
            : select.selectedIndex === 2 ? 'bg-danger' : 'bg-primary';
        select.classList.add(color, 'fw-bold', 'text-white');
    }

    document.querySelectorAll('.status-select').forEach(function (select) {
        updateStatusColor(select);
        let savedStatus = select.value;
        select.addEventListener('change', async function () {
            select.disabled = true;
            try {
                const response = await fetch('@Url.Action("UpdateStatus", "Item")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({
                        id: select.dataset.orderId,
                        status: select.value,
                        __RequestVerificationToken: document.querySelector('input[name="__RequestVerificationToken"]').value
                    })
                });
                if (!response.ok) {
                    const message = response.status === 400 ? await response.text() : '';
                    throw new Error(message || 'Cannot update order status.');
                }
                savedStatus = select.value;
                showOrderToast('Status updated successfully.');
            } catch (error) {
                select.value = savedStatus;
                showOrderToast(error.message || 'Cannot update order status.', true);
            } finally {
                updateStatusColor(select);
                select.disabled = savedStatus === 'Đã giao' || savedStatus === 'Hủy' || savedStatus === 'Huỷ';
            }
        });
    });

    const modal = document.getElementById('orderModal');
    const form = document.getElementById('orderForm');

    form.addEventListener('submit', async function (event) {
        event.preventDefault();
        const submitButton = form.querySelector('button[type="submit"]');
        submitButton.disabled = true;
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            });
            if (!response.ok) {
                if (response.status === 400 && !document.getElementById('editOrderId').value) {
                    bootstrap.Modal.getOrCreateInstance(modal).hide();
                }
                const message = response.status === 400 ? await response.text() : '';
                throw new Error(message || 'Cannot save order.');
            }
            window.location.href = '@Url.Action("Home", "Home")';
        } catch (error) {
            showOrderToast(error.message || 'Cannot save order.', true);
        } finally {
            submitButton.disabled = false;
        }
    });

    modal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const isEdit = button.dataset.mode === 'edit';

        form.reset();
        form.action = isEdit
            ? '@Url.Action("Update", "Item")'
            : '@Url.Action("Add", "Item")';

        document.getElementById('editOrderId').value = button.dataset.id ?? '';
        document.getElementById('customerName').value = button.dataset.customer ?? '';
        document.getElementById('productName').value = button.dataset.product ?? '';
        document.getElementById('quantity').value = button.dataset.quantity ?? '';
        document.getElementById('price').value = button.dataset.price ?? '';
        document.getElementById('modalTitle').textContent =
            isEdit ? 'Edit Order' : 'Add Order';
    });

    if (selectAll) {
        selectAll.addEventListener('change', () => {
            items.forEach(item => item.checked = selectAll.checked);
        });
    }

    items.forEach(item => {
        item.addEventListener('change', () => {
            selectAll.checked = Array.from(items).every(i => i.checked);
        });
    });

</script>
